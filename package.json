{
  "name": "monitor",
  "version": "2.6.111301",
  "private": true,
  "description": "Watch CPU, memory, disk, claude sessions and runners from the menu bar",
  "homepage": "https://github.com/RUNNERS-IM/monitor",
  "license": "UNLICENSED",
  "author": "RUNNERS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && pnpm check:account && electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint -c .oxlintrc.monitor.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "native": "napi build --manifest-path native/Cargo.toml --package-json-path native/package.json --platform --release --output-dir native --no-js",
    "check:locales": "node scripts/check-locales.mjs",
    "check:account": "node src/renderer/runners-account/check.mjs --kit 0.1.31 && node src/main/runners/check.mjs --kit 0.1.31 && node scripts/check.mjs --kit 0.1.31",
    "notices": "node scripts/third-party-notices.mjs Monitor",
    "dist": "pnpm build && electron-builder --config electron-builder.config.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "i18next": "^26.7.1",
    "lucide-react": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.8.6",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "productName": "Monitor"
}
