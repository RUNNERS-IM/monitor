{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monitor",
  "version": "2.6.1030",
  "identifier": "im.runners.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Monitor",
        "width": 380,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Runners Co., Ltd (RGWVXJ8URP)"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCREIwMDMzMzM0NzYwRDAKUldUUVlFY3pNd0RibTc5bEYyWjZJSzA4a3Q1MU5iNlRJOVFFdjZVbU10N2dyV1dOSy9WMmxMOGEK",
      "endpoints": [
        "https://github.com/RUNNERS-IM/monitor/releases/latest/download/latest.json"
      ]
    }
  }
}
